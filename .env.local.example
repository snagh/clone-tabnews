# Configurações de SMTP para Envio de E-mails
# Renomeie este arquivo para .env.local para que o Next.js o carregue localmente.

# Servidor SMTP de envio (Ex: smtp.gmail.com para Gmail, smtp.mailtrap.io para testes, ou do seu provedor de hospedagem)
SMTP_HOST=smtp.gmail.com

# Porta do servidor SMTP (Ex: 587 para STARTTLS ou 465 para SSL)
SMTP_PORT=587

# Usuário do e-mail de envio (Ex: seu-email@gmail.com)
SMTP_USER=seu-email-remetente@gmail.com

# Senha do e-mail de envio (Para Gmail, use uma "Senha de App" gerada nas configurações da sua conta Google, e não a sua senha pessoal)
SMTP_PASS=sua-senha-de-app-ou-senha-smtp

# E-mail de destino que receberá todos os relatórios de briefings preenchidos
RECEIVER_EMAIL=seu-email-destinatario@gmail.com
